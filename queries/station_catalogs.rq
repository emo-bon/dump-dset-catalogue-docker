PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX schema: <https://schema.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>

CONSTRUCT {
  # 1. Define newly minted station catalog and link datasets
  ?newCatalog a dcat:Catalog ;
              dcterms:title ?catalogTitle ;
              dcterms:description ?catalogDesc ;
              dcat:dataset ?ds .
  
  # 2. Reconstruct properties of all linked datasets
  ?ds ?p ?o .
}
WHERE {
  {
    # Match L1 Observatory Crates
    ?obsMetadata a schema:CreativeWork ;
                 schema:about ?ds .
    FILTER(CONTAINS(STR(?ds), "/observatory-"))
    BIND(REPLACE(STR(?ds), "^.*/observatory-([A-Za-z0-9\\-]+)-crate/?$", "$1") AS ?obsCode)
  }
  UNION
  {
    # Match L2 Analysis Crates
    ?catalog a dcat:Catalog ;
             dcat:dataset ?ds .
    FILTER(CONTAINS(STR(?ds), "analysis-results"))
    BIND(REPLACE(STR(?ds), "^.*EMOBON_([A-Za-z0-9\\-]+)_.*$", "$1", "i") AS ?obsCode)
  }

  # Generate dynamic station catalog URIs and descriptive literals
  BIND(IRI(CONCAT("https://data.emobon.embrc.eu/#catalog-", LCASE(?obsCode))) AS ?newCatalog)
  BIND(STRLANG(CONCAT("EMO BON Combined Catalog: ", UCASE(?obsCode)), "en") AS ?catalogTitle)
  BIND(STRLANG(CONCAT("Contains the observatory starting dataset and analysis results for ", UCASE(?obsCode)), "en") AS ?catalogDesc)

  ?ds ?p ?o .
}